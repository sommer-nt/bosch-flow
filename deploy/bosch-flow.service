# systemd-Dienst: startet die Streamlit-App beim Booten und nach Abstürzen neu.
# Installiert nach /etc/systemd/system/bosch-flow.service (macht deploy/install.sh).
[Unit]
Description=Bosch Flow – Netz- & Anlagenrechner (Streamlit)
After=network.target

[Service]
Type=simple
User=boschflow
Group=boschflow
WorkingDirectory=/opt/bosch-flow
# Nur lokal lauschen – von außen erreichbar ist die App ausschließlich über nginx.
ExecStart=/opt/bosch-flow/.venv/bin/streamlit run app.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=always
RestartSec=5
# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

# Kopieren nach deploy/.env und ausfüllen (diese Datei NICHT committen)
APP_PASSWORT=ein-sicheres-passwort
# Lokaler Port der App (nginx leitet flow.sommer-nt.de dorthin; 8503 nutzt climate)
APP_PORT=8504
# Speicherauswahl (eigener Container, nginx leitet speicher.sommer-nt.de dorthin)
SPEICHER_PORT=8505
# Eigenes Passwort für die Speicherauswahl (leer lassen = gleiches Passwort wie APP_PASSWORT)
SPEICHER_PASSWORT=
